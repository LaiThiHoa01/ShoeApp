<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SHIPPED: Blue (state_activated) -->
    <item android:state_activated="true" android:drawable="@drawable/bg_admin_status_shipped" />
    
    <!-- DELIVERED/COMPLETED: Green (state_enabled="false") -->
    <item android:state_enabled="false" android:drawable="@drawable/bg_admin_status_delivered" />
    
    <!-- CANCELLED: Red (state_selected) -->
    <item android:state_selected="true" android:drawable="@drawable/bg_admin_status_cancelled" />
    
    <!-- PENDING/PROCESSING: Orange/Yellow (default) -->
    <item android:drawable="@drawable/bg_admin_status_processing" />
</selector>
