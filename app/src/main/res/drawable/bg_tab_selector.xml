<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab selector (My Orders tabs, Admin filter tabs)
  Selected = orange fill, unselected = transparent
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_orange" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_orange" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_secondary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

</selector>
