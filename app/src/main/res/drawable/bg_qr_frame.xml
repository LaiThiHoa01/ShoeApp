<?xml version="1.0" encoding="utf-8"?>
<!--
  QR Code frame — white bg, border, rounded large
  Tương đương: p-5 rounded-3xl border-2 border-gray-100 bg-white shadow-lg
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_primary" />
    <corners android:radius="@dimen/radius_3xl" />
    <stroke
        android:width="@dimen/stroke_normal"
        android:color="@color/border_normal" />
</shape>
