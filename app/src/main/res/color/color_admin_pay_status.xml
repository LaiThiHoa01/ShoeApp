<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PAID: White (state_enabled="false") -->
    <item android:state_enabled="false" android:color="@color/brand_white" />
    
    <!-- FAILED: White (state_selected="true") -->
    <item android:state_selected="true" android:color="@color/brand_white" />
    
    <!-- UNPAID: Text Primary (default) -->
    <item android:color="@color/text_primary" />
</selector>
