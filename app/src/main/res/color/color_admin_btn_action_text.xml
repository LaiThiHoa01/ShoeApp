<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SHIPPED: White (state_activated="true") -->
    <item android:state_activated="true" android:color="@color/brand_white" />
    
    <!-- CANCELLED: Red (state_selected="true", state_enabled="false") -->
    <item android:state_selected="true" android:state_enabled="false" android:color="@color/status_error" />
    
    <!-- DELIVERED: Green (state_selected="false", state_enabled="false") -->
    <item android:state_enabled="false" android:color="@color/status_success" />
    
    <!-- default (PROCESSING/PENDING): White (enabled="true") -->
    <item android:color="@color/brand_white" />
</selector>
