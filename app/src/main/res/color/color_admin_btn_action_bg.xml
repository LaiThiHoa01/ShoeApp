<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SHIPPED: Blue (state_activated="true") -->
    <item android:state_activated="true" android:color="@color/status_info" />
    
    <!-- CANCELLED: Light Red (state_selected="true", state_enabled="false") -->
    <item android:state_selected="true" android:state_enabled="false" android:color="@color/status_error_bg" />
    
    <!-- DELIVERED: Light Green (state_selected="false", state_enabled="false") -->
    <item android:state_enabled="false" android:color="@color/status_success_bg" />
    
    <!-- default (PROCESSING/PENDING): Orange (enabled="true") -->
    <item android:color="@color/brand_orange" />
</selector>
