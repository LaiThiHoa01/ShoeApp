<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/brand_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_promo_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Đang diễn ra"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_white"
            android:background="@drawable/bg_status_delivered"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tv_promo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="SALE ĐÓN HÈ MÁT MẺ"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_promo_image"/>

        <TextView
            android:id="@+id/tv_promo_voucher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Mã: SUMMER20 (Còn: 100)"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/brand_orange"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_promo_image"/>
            
        <TextView
            android:id="@+id/tv_promo_discount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Giảm: 20%"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_voucher"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_promo_image"/>

        <TextView
            android:id="@+id/tv_promo_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Từ 01/06/2026 - 30/07/2026"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_discount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_promo_image"/>

        <ImageView
            android:id="@+id/iv_promo_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
