<?xml version="1.0" encoding="utf-8"?>
<!--
  ADMIN — PRODUCT VARIANT MANAGEMENT
  Activity: AdminProductVariantActivity.java
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/variant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary"
    tools:context=".admin.AdminProductVariantActivity">

    <!-- HEADER BAR -->
    <LinearLayout
        android:id="@+id/variant_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/variant_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_admin_icon_btn"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_dark_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản lý biến thể"
                android:textColor="@color/text_dark_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/variant_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark_muted"
                android:textSize="12sp"
                tools:text="Adidas UltraBoost" />
        </LinearLayout>
    </LinearLayout>

    <!-- LIST OF VARIANTS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/variant_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@id/variant_actions_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/variant_header"
        tools:listitem="@layout/item_admin_product_variant" />

    <!-- ACTION BUTTONS BAR -->
    <LinearLayout
        android:id="@+id/variant_actions_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_secondary"
        android:orientation="horizontal"
        android:padding="@dimen/space_screen_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Add Variant Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/variant_btn_add"
            style="@style/Widget.SoleStep.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Thêm biến thể"
            app:icon="@drawable/ic_catalog_plus"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Save Changes Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/variant_btn_save"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="Lưu thay đổi"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
