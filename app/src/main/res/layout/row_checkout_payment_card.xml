<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginTop="@dimen/space_10"
    android:background="@drawable/bg_checkout_selected"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_10">

    <ImageView
        android:layout_width="@dimen/icon_lg"
        android:layout_height="@dimen/icon_lg"
        android:src="@drawable/ic_card" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•••• •••• •••• 4242"
            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visa · Expires 12/27"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
    </LinearLayout>

    <View
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_radio_selected" />
</LinearLayout>
