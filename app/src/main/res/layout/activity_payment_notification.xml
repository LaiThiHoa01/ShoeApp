<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    tools:context=".user.PaymentNotification">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="	4111111111111111" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Circular Status Icon Container -->
            <FrameLayout
                android:id="@+id/frameStatusIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_success_halo">

                <ImageView
                    android:id="@+id/imgPaymentStatus"
                    android:layout_width="78dp"
                    android:layout_height="75dp"
                    android:layout_gravity="center"
                    android:src="@drawable/check_circle_24dp"
                    app:tint="@color/status_success" />
            </FrameLayout>

            <!-- Status Title -->
            <TextView
                android:id="@+id/tvPaymentStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Thanh toán thành công"
                android:textColor="@color/status_success"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Status Description -->
            <TextView
                android:id="@+id/tvPaymentStatusDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Đơn hàng của bạn đã được ghi nhận vào hệ thống."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light"
                android:layout_marginBottom="24dp"/>

            <!-- Auto Redirect Hint -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/brand_orange"
                    style="?android:attr/progressBarStyleSmall" />

                <TextView
                    android:id="@+id/textViewNotify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang chuyển hướng về Đơn hàng sau 2 giây..."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>