<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_home_product_card"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_home_product_image_gray">

        <TextView
            android:layout_width="44dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_6"
            android:background="@drawable/bg_catalog_discount_badge"
            android:gravity="center"
            android:text="-23%"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
            android:textColor="@color/brand_white"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="132dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:rotation="-8"
            android:src="@drawable/ic_shoe"
            android:tint="@color/text_secondary" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:text="DarkStep"
        android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:text="Shadow Force"
        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_8"
        android:text="* 4.5  (98)"
        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
        android:textColor="@color/text_tertiary" />

    <include layout="@layout/row_catalog_price_shadow" />
</LinearLayout>
