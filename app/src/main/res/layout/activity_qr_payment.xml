<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".QRPaymentActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_screen_vertical"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_screen_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="@dimen/btn_icon_size"
            android:layout_height="@dimen/btn_icon_size"
            android:background="@drawable/bg_rounded_gray"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/qr_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/qr_title"
            android:textAppearance="@style/TextAppearance.SoleStep.Subheading" />

        <TextView
            android:id="@+id/qr_security_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_delivered"
            android:gravity="center"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:text="@string/qr_secure"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
            android:textColor="@color/status_success"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/border_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen_horizontal"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_screen_horizontal"
            android:paddingBottom="@dimen/space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_amount_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_label_amount"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/text_dark_muted" />

                <TextView
                    android:id="@+id/qr_amount_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="$377.97"
                    android:textAppearance="@style/TextAppearance.SoleStep.PriceLarge"
                    android:textColor="@color/brand_white" />

                <TextView
                    android:id="@+id/qr_order_id_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order #SS-10495"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/text_dark_faint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_qr_frame"
                android:elevation="@dimen/elev_raised"
                android:padding="@dimen/qr_frame_padding">

                <com.example.shoeapp.FakeQrCodeView
                    android:id="@+id/qr_code_view"
                    android:layout_width="@dimen/qr_code_size"
                    android:layout_height="@dimen/qr_code_size"
                    android:layout_gravity="center" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_circle_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="@string/qr_expires"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

                <TextView
                    android:id="@+id/qr_timer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="14:58"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/payment_instructions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="vertical">

                <include layout="@layout/row_payment_instruction_1" />

                <include layout="@layout/row_payment_instruction_2" />

                <include layout="@layout/row_payment_instruction_3" />

                <include layout="@layout/row_payment_instruction_4" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_input_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_8">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qr_label_ref"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

                    <TextView
                        android:id="@+id/qr_reference_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SS-PAY-2026-10495"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/copy_qr_reference_button"
                    android:layout_width="@dimen/btn_icon_size_small"
                    android:layout_height="@dimen/btn_icon_size_small"
                    android:background="@drawable/bg_rounded_gray"
                    android:contentDescription="@string/action_copy"
                    android:padding="@dimen/space_6"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/qr_accepted_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/qr_accepted"
                android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

            <LinearLayout
                android:id="@+id/accepted_payments_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/accepted_payment_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bank_chip"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="Chase"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

                <TextView
                    android:id="@+id/accepted_payment_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:background="@drawable/bg_bank_chip"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="PayPal"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

                <TextView
                    android:id="@+id/accepted_payment_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:background="@drawable/bg_bank_chip"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="Zelle"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/simulate_payment_button"
                style="@style/Widget.SoleStep.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/qr_btn_simulate_payment" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
