<?xml version="1.0" encoding="utf-8"?>
<!--
  Item sản phẩm trong chi tiết đơn hàng (Admin)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_4">

    <!-- Ảnh sản phẩm -->
    <ImageView
        android:id="@+id/detail_prod_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_admin_product_image"
        android:contentDescription="@null"
        android:padding="@dimen/space_4"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_shoe" />

    <!-- Thông tin chính -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Hãng -->
        <TextView
            android:id="@+id/detail_prod_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NovaSole"
            android:textColor="@color/text_dark_muted"
            android:textSize="11sp" />

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/detail_prod_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Air Phantom Pro"
            android:textColor="@color/text_dark_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Size & Màu sắc -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_prod_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_icon_btn"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="1dp"
                android:text="Size: 42"
                android:textColor="@color/text_dark_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_prod_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:background="@drawable/bg_admin_icon_btn"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="1dp"
                android:text="Black"
                android:textColor="@color/text_dark_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Đơn giá x Số lượng -->
        <TextView
            android:id="@+id/detail_prod_qty_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dark_muted"
            android:textSize="12sp"
            android:text="$189.99 x 1" />
    </LinearLayout>

    <!-- Thành tiền (subtotal của sản phẩm) -->
    <TextView
        android:id="@+id/detail_prod_subtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:textColor="@color/text_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="$189.99" />
</LinearLayout>
