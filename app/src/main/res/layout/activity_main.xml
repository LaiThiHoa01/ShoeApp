<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".user.MainActivity">

    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_header_height"
        android:background="@drawable/bg_auth_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-54dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_header_ring" />

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-34dp"
            android:layout_marginEnd="38dp"
            android:background="@drawable/bg_header_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/auth_logo_size"
                    android:layout_height="@dimen/auth_logo_size"
                    android:background="@drawable/bg_logo_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sole_step_mark" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/auth_brand"
                    android:textColor="@color/brand_white"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/auth_tagline"
                android:textColor="@color/auth_tagline"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_content_padding"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/auth_content_padding"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/auth_welcome_back"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="@string/auth_sign_in_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/font_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/auth_label_email"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_label" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="7dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_selector"
                android:fontFamily="sans-serif"
                android:inputType="textEmailAddress"
                android:paddingStart="@dimen/input_padding_h"
                android:paddingEnd="@dimen/input_padding_h"
                android:selectAllOnFocus="false"
                android:singleLine="true"
                android:hint="email"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:hint="@string/auth_label_password"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_label" />

            <FrameLayout
                android:id="@+id/passwordField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_light">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/input_padding_h"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:hint="Nhập mật khaaur"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_body" />

                <ImageButton
                    android:id="@+id/passwordVisibility"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_show_password"
                    android:padding="13dp"
                    android:src="@drawable/ic_visibility" />
            </FrameLayout>

            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/auth_forgot_password"
                android:textColor="@color/brand_orange"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_large"
                android:layout_marginTop="18dp"
                android:elevation="7dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/auth_btn_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/brand_white"
                android:textSize="@dimen/font_button"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_orange"
                app:cornerRadius="@dimen/radius_button"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconTint="@color/brand_white"
                app:rippleColor="@color/brand_orange_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleSignInButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_large"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/auth_google"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_button"
                app:backgroundTint="@color/bg_secondary"
                app:cornerRadius="@dimen/radius_button"
                app:icon="@drawable/ic_google_g"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@null"
                app:rippleColor="@color/border_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="@dimen/stroke_thin" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="27dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/auth_no_account"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/signUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/auth_btn_sign_up"
                    android:textColor="@color/brand_orange"
                    android:textSize="@dimen/font_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
