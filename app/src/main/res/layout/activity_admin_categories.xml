<?xml version="1.0" encoding="utf-8"?>
<!--
  ┌────────────────────────────────────────────┐
  │  ADMIN — CATEGORIES                        │
  │  Activity: AdminCategoriesActivity.java    │
  │  Màn hình quản lý danh mục của admin       │
  └────────────────────────────────────────────┘

  Cấu trúc:
    ConstraintLayout (root, bg_dark_primary)
      └─ [Header]   "Categories" + "+ Add" button
      └─ [Subtitle] "6 categories · 180 products total"
      └─ [List]     RecyclerView (item_admin_category)
      └─ [BottomNav] 2 tab: Products / Orders (hoặc tuỳ chỉnh)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_categories_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".admin.AdminCategoriesActivity">

    <!-- ══════════════════════════════════════
         HEADER: Title & Statistics
         ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/admin_categories_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/app_admin_portal"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/admin_categories_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_categories_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/admin_categories_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="6 categories · 180 products total" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         MANAGEMENT PANEL
         ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/admin_categories_mgmt_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_screen_horizontal"
        android:layout_marginEnd="@dimen/space_screen_horizontal"
        android:background="@drawable/bg_card_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/admin_categories_header">

        <!-- Search / Filter Placeholder -->
        <LinearLayout
            android:id="@+id/admin_categories_search_row"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_material_search"
                android:tint="@color/text_muted" />

            <EditText
                android:id="@+id/admin_categories_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/admin_search_categories_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>



        <!-- Add Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_categories_btn_add"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_2"
            android:padding="0dp"
            app:icon="@drawable/ic_catalog_plus"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         CATEGORY LIST
         ══════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/admin_categories_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_4"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@id/admin_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/admin_categories_mgmt_panel"
        tools:itemCount="4"
        tools:listitem="@layout/item_admin_category" />

    <!-- ══════════════════════════════════════
         BOTTOM NAVIGATION
         ══════════════════════════════════════ -->
    <include
        layout="@layout/view_admin_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
