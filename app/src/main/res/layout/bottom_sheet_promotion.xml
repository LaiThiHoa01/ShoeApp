<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <ImageView
        android:id="@+id/iv_promo_cover"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:background="@color/bg_secondary"
        app:layout_constraintTop_toBottomOf="@id/drag_handle" />

    <TextView
        android:id="@+id/tv_promo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        tools:text="SALE ĐÓN HÈ MÁT MẺ"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark_primary"
        app:layout_constraintTop_toBottomOf="@id/iv_promo_cover" />

    <TextView
        android:id="@+id/tv_promo_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="20dp"
        tools:text="Nhập mã SUMMER20 để được giảm 20% cho tất cả các sản phẩm giày chạy bộ. Nhanh tay kẻo lỡ!"
        android:textSize="14sp"
        android:textColor="@color/text_dark_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_promo_title" />

    <LinearLayout
        android:id="@+id/layout_voucher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_light"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_promo_description">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tag"
            app:tint="@color/brand_orange"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã giảm giá:"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_dark_secondary"/>
            
        <TextView
            android:id="@+id/tv_promo_voucher_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            tools:text="SUMMER20"
            android:textStyle="bold"
            android:textColor="@color/brand_orange"
            android:gravity="end"/>
            
    </LinearLayout>

    <Button
        android:id="@+id/btn_buy_now"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:text="MUA NGAY"
        android:textColor="@color/brand_white"
        android:textStyle="bold"
        android:backgroundTint="@color/brand_orange"
        app:layout_constraintTop_toBottomOf="@id/layout_voucher" />

</androidx.constraintlayout.widget.ConstraintLayout>
