<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    tools:context=".authentication.ChangePasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_button_light"
            android:contentDescription="@string/back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/auth_change_password_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_auth_alert"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_auth_alert_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/brand_white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/auth_secure_update"
                        android:textColor="@color/brand_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/auth_secure_update_subtitle"
                        android:textColor="@color/brand_white"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/AuthLabel"
                android:layout_marginTop="24dp"
                android:text="@string/auth_label_current_password" />

            <FrameLayout
                android:id="@+id/currentPasswordField"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_signup_field">

                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:hint="Email tài khoản"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@android:color/black"
                    android:textSize="13sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/border_light" />

            <TextView
                style="@style/AuthLabel"
                android:layout_marginTop="18dp"
                android:text="@string/auth_label_new_password" />

            <FrameLayout
                android:id="@+id/newPasswordField"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_signup_field">

                <EditText
                    android:id="@+id/newPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/newPasswordVisibility"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_show_password"
                    android:padding="13dp"
                    android:src="@drawable/ic_visibility" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_active" />
            </LinearLayout>

            <TextView
                style="@style/AuthLabel"
                android:layout_marginTop="16dp"
                android:text="@string/auth_label_confirm_password" />

            <FrameLayout
                android:id="@+id/confirmPasswordField"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_signup_field">

                <EditText
                    android:id="@+id/confirmPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="84dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/checkMarkIcon"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="40dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/check_mark"
                    android:textColor="@color/status_success"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/confirmPasswordVisibility"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_show_password"
                    android:padding="13dp"
                    android:src="@drawable/ic_visibility" />
            </FrameLayout>

            <TextView
                android:id="@+id/passwordMatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="@string/auth_passwords_match"
                android:textColor="@color/status_success"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_requirements_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="@string/auth_requirements"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <include layout="@layout/row_password_requirement_length" />
                <include layout="@layout/row_password_requirement_uppercase" />
                <include layout="@layout/row_password_requirement_number" />
                <include layout="@layout/row_password_requirement_special" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updatePasswordButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:elevation="8dp"
                android:fontFamily="sans-serif-medium"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Đặt lại mật khẩu"
                android:textAllCaps="false"
                android:textColor="@color/brand_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_orange"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/brand_white"
                app:rippleColor="@color/brand_orange_dark" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
