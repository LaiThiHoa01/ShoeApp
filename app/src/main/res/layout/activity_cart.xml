<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    tools:context=".user.CartActivity">

    <ScrollView
        android:id="@+id/cart_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/cart_checkout_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen_horizontal"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_screen_horizontal"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/cart_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="@dimen/btn_icon_size"
                    android:layout_height="@dimen/btn_icon_size"
                    android:background="@drawable/bg_home_notification"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:text="@string/cart_title"
                    android:textAppearance="@style/TextAppearance.SoleStep.Headline"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/cart_count_badge"
                    android:layout_width="24dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_cart_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cart_items_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/cart_empty_text"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:gravity="center"
                android:text="Giỏ hàng đang trống"
                android:textAppearance="@style/TextAppearance.SoleStep.Body"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cart_promo_card"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_8">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cart_promo"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tag" />

                    <EditText
                        android:id="@+id/cart_promo_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Nhập mã khuyến mãi"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cart_promo_apply_button"
                    style="@style/Widget.SoleStep.Button.Primary"
                    android:layout_width="74dp"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:text="@string/cart_btn_apply_promo"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Suggested Promo -->
            <LinearLayout
                android:id="@+id/layout_suggested_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cart_item_card"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:visibility="gone">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gợi ý:"
                    android:textColor="@color/text_secondary"/>
                    
                <TextView
                    android:id="@+id/tv_suggested_promo_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    tools:text="SUMMER20 - Giảm 20%"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold"/>
                    
                <Button
                    android:id="@+id/btn_use_suggested_promo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Dùng"
                    android:textSize="12sp"
                    style="?attr/materialButtonOutlinedStyle"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cart_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cart_summary_title"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_subtotal"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/cart_subtotal_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_shipping"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/cart_shipping_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_discount"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/cart_discount_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/status_success"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@color/border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_total"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cart_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.PriceMedium"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/cart_checkout_bar"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:background="@color/bg_primary"
        android:elevation="@dimen/elev_bottom_nav"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_screen_horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkout_button"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tiến hành thanh toán"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/space_4"
            app:iconTint="@color/brand_white" />
    </LinearLayout>

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
