<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SoleStep.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_8"
    android:layout_marginVertical="@dimen/space_4"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_6">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/badge_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pending"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="@string/orders_tab_pending"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/badge_processing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pending"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="@string/status_processing"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/badge_shipping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_shipping"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="@string/status_shipping"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/status_info_medium"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/badge_delivered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_delivered"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="@string/status_delivered"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/status_success"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/badge_cancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_gray"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_2"
                    android:text="@string/status_cancelled"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/order_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="26 Tháng 6, 2026"
                android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_thin"
            android:background="@color/border_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Product Image -->
                <ImageView
                    android:id="@+id/order_product_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_detail_hero"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_shoe"
                    android:tint="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Order Name / Product Name -->
                    <TextView
                        android:id="@+id/order_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Tên sản phẩm đơn hàng"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/order_item_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="2 sản phẩm"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/order_total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="1.200.000 đ"
                    android:textAppearance="@style/TextAppearance.SoleStep.PriceSmall" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_order_details"
                style="@style/Widget.SoleStep.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Xem chi tiết" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
