<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginTop="@dimen/space_10"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_home_product_image_light">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:rotation="-15"
            android:src="@drawable/ic_shoe"
            android:tint="@color/text_disabled" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Air Phantom Pro"
            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="US 10 · Qty: 1"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$189.99"
        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />
</LinearLayout>
