<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    tools:context=".user.CheckoutActivity">

    <ScrollView
        android:id="@+id/checkout_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/checkout_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen_horizontal"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_screen_horizontal"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/checkout_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="@dimen/btn_icon_size"
                    android:layout_height="@dimen/btn_icon_size"
                    android:background="@drawable/bg_home_notification"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:layout_weight="1"
                    android:text="Thanh toán"
                    android:textAppearance="@style/TextAppearance.SoleStep.Headline"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/checkout_item_count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_home_brand_chip"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_10"
                    android:paddingEnd="@dimen/space_10"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin nhận hàng"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/checkout_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_input_selector"
                    android:hint="Họ và tên"
                    android:inputType="textPersonName"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/checkout_phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_input_selector"
                    android:hint="Số điện thoại"
                    android:inputType="phone"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/checkout_address_input"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_input_selector"
                    android:gravity="top"
                    android:hint="Địa chỉ giao hàng"
                    android:inputType="textPostalAddress|textMultiLine"
                    android:padding="@dimen/space_12"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/checkout_note_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_input_selector"
                    android:hint="Ghi chú cho shop hoặc shipper"
                    android:inputType="text"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phương thức giao hàng"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/delivery_standard"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/selector_checkout_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_truck"
                        android:tint="@color/brand_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giao tiêu chuẩn"
                            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhận hàng trong 3-5 ngày"
                            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30.000 đ"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/delivery_express"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/selector_checkout_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giao nhanh"
                            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhận hàng trong 1-2 ngày"
                            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60.000 đ"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/delivery_nextday"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/selector_checkout_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_delivery_truck_speed"
                        android:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giao hoả tốc"
                            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Áp dụng nội thành"
                            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90.000 đ"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phương thức thanh toán"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/payment_qr"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/selector_checkout_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/logo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="Thanh toán bằng ZaloPay"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/payment_cod"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/selector_checkout_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_10">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_truck"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="Thanh toán khi nhận hàng"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

<!--                <LinearLayout-->
<!--                    android:id="@+id/payment_card"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="62dp"-->
<!--                    android:layout_marginTop="@dimen/space_8"-->
<!--                    android:background="@drawable/bg_checkout_option"-->
<!--                    android:gravity="center_vertical"-->
<!--                    android:orientation="horizontal"-->
<!--                    android:padding="@dimen/space_10">-->

<!--                    <ImageView-->
<!--                        android:layout_width="@dimen/icon_md"-->
<!--                        android:layout_height="@dimen/icon_md"-->
<!--                        android:src="@drawable/ic_card" />-->

<!--                    <TextView-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginStart="@dimen/space_10"-->
<!--                        android:layout_weight="1"-->
<!--                        android:text="Thẻ nội địa hoặc quốc tế"-->
<!--                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"-->
<!--                        android:textColor="@color/text_primary"-->
<!--                        android:textStyle="bold" />-->
<!--                </LinearLayout>-->
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sản phẩm trong đơn"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/checkout_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:gravity="center"
                    android:padding="@dimen/space_16"
                    android:text="Giỏ hàng đang trống"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/checkout_items_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_checkout_product" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@color/border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tạm tính"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/checkout_subtotal_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phí giao hàng"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/checkout_shipping_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Giảm giá"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/checkout_discount_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/status_success" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@color/border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng thanh toán"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkout_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SoleStep.PriceMedium"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/checkout_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@color/bg_primary"
        android:elevation="@dimen/elev_bottom_nav"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/space_screen_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/place_order_button"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tiếp tục thanh toán" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:text="Thông tin đơn hàng sẽ được chuyển sang bước thanh toán"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
            android:textColor="@color/text_muted" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
