<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    tools:context=".user.CheckoutActivity">

    <ScrollView
        android:id="@+id/checkout_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/checkout_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen_horizontal"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_screen_horizontal"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/checkout_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="@dimen/btn_icon_size"
                    android:layout_height="@dimen/btn_icon_size"
                    android:background="@drawable/bg_home_notification"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:text="@string/checkout_title"
                    android:textAppearance="@style/TextAppearance.SoleStep.Headline"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/checkout_steps"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_checkout_step_done"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/brand_white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_step_address"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/status_success" />
                </LinearLayout>

                <View
                    android:layout_width="54dp"
                    android:layout_height="@dimen/stroke_normal"
                    android:background="@color/status_success" />

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_checkout_step_current"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/brand_white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_step_payment"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <View
                    android:layout_width="54dp"
                    android:layout_height="@dimen/stroke_normal"
                    android:background="@color/border_normal" />

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_checkout_step_next"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_step_review"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_map_pin"
                        android:tint="@color/brand_orange" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:text="@string/checkout_delivery_title"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_change"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_checkout_selected"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_10"
                    android:text="Alex Johnson&#10;123 Sneaker Ave, Apt 4B&#10;New York, NY 10001&#10;+1 (555) 018-2847"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_truck"
                        android:tint="@color/brand_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:text="@string/checkout_delivery_method"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <include layout="@layout/row_checkout_delivery_standard" />

                <include layout="@layout/row_checkout_delivery_express" />

                <include layout="@layout/row_checkout_delivery_nextday" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_card" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:text="@string/checkout_payment_title"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_add_new"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <include layout="@layout/row_checkout_payment_card" />

                <include layout="@layout/row_checkout_payment_qr" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_cart_item_card"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_summary_title"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 items  ›"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <include layout="@layout/row_checkout_item_air" />

                <include layout="@layout/row_checkout_item_blaze" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@color/border_light" />

                <include layout="@layout/row_cart_summary_subtotal" />

                <include layout="@layout/row_cart_summary_shipping" />

                <include layout="@layout/row_cart_summary_discount" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@color/border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cart_total"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$617.96"
                        android:textAppearance="@style/TextAppearance.SoleStep.PriceMedium"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/checkout_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@color/bg_primary"
        android:elevation="@dimen/elev_bottom_nav"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/space_screen_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/place_order_button"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Place Order - $617.96" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:text="@string/checkout_secure_msg"
            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
            android:textColor="@color/text_muted" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
