<?xml version="1.0" encoding="utf-8"?>
<!--
  Item đơn hàng — Admin Order Management RecyclerView
  Dùng trong: AdminOrderManagementActivity với RecyclerView + Adapter
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_card_padding"
    android:paddingTop="@dimen/space_card_padding"
    android:paddingEnd="@dimen/space_card_padding"
    android:paddingBottom="@dimen/space_card_padding">

    <!-- ── Hàng 1: Status badge + Date ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status badge (Processing / Shipped / Delivered) -->
        <LinearLayout
            android:id="@+id/admin_order_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_status_processing"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_2">

            <ImageView
                android:id="@+id/admin_order_status_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                android:tint="@color/status_warning" />

            <TextView
                android:id="@+id/admin_order_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:text="@string/status_processing"
                android:textColor="@color/status_warning"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Progress dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/admin_order_dot_1"
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="@color/status_warning"
                    android:backgroundTint="@color/status_warning" />

                <View
                    android:id="@+id/admin_order_dot_2"
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:background="@color/border_dark_medium" />

                <View
                    android:id="@+id/admin_order_dot_3"
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:background="@color/border_dark_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Ngày đặt -->
        <TextView
            android:id="@+id/admin_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ── Hàng 2: Order ID ── -->
    <TextView
        android:id="@+id/admin_order_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textColor="@color/text_dark_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ── Hàng 3: Tên khách hàng ── -->
    <TextView
        android:id="@+id/admin_order_customer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_dark_tertiary"
        android:textSize="13sp" />

    <!-- ── Hàng 4: Tổng tiền + số items ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/admin_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/admin_order_items_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── Hàng 5: Action buttons ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- View Details -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_order_btn_view"
            style="@style/Widget.SoleStep.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/admin_view_details"
            android:textSize="10sp"
            android:maxLines="1"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconSize="14dp" />

        <!-- Cancel Order Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_order_btn_cancel"
            style="@style/Widget.SoleStep.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="Hủy đơn"
            android:textColor="@color/status_error"
            app:strokeColor="@color/status_error"
            android:textSize="10sp"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- Mark as Shipped / Mark as Delivered / Delivered -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_order_btn_action"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/admin_mark_shipped"
            android:textSize="10sp"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:icon="@null" />
    </LinearLayout>

</LinearLayout>
