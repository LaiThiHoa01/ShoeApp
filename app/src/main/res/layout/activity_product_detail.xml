<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".user.ProductDetailActivity">

    <ScrollView
        android:id="@+id/detail_product_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/detail_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <FrameLayout
                android:id="@+id/detail_hero"
                android:layout_width="match_parent"
                android:layout_height="312dp"
                android:background="@drawable/bg_detail_hero">

                <ImageView
                    android:id="@+id/detail_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/detail_label_brand"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_shoe" />

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="@dimen/btn_icon_size"
                    android:layout_height="@dimen/btn_icon_size"
                    android:layout_marginStart="@dimen/space_screen_horizontal"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_home_notification"
                    android:contentDescription="@string/action_back"
                    android:elevation="@dimen/elev_card"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/detail_badge_new"
                    android:layout_width="52dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/space_screen_horizontal"
                    android:layout_marginTop="86dp"
                    android:background="@drawable/bg_home_sale_badge"
                    android:gravity="center"
                    android:text="@string/detail_badge_new"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/brand_white"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/detail_thumbnail_container"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_10"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_screen_horizontal"
                android:paddingTop="@dimen/space_10"
                android:paddingEnd="@dimen/space_screen_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_brand_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nike"
                            android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detail_name_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nike Air Force 1 '07"
                            android:textAppearance="@style/TextAppearance.SoleStep.Headline"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_price_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.929.000 đ"
                            android:textAppearance="@style/TextAppearance.SoleStep.PriceMedium"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/detail_original_price_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.239.000 đ"
                            android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                            android:textColor="@color/text_disabled" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_rating_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_rating_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★★★★★"
                        android:textColor="@color/star_filled"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_rating_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        tools:text="4.8"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/detail_review_count_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:text="(284 đánh giá)"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/detail_label_color"
                    android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/detail_color_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="horizontal">
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_label_size"
                        android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_size_guide"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/detail_size_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:columnCount="5" />

                <LinearLayout
                    android:id="@+id/detail_quantity_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số lượng"
                        android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/detail_quantity_minus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_cart_stepper"
                        android:gravity="center"
                        android:text="-"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/detail_quantity_text"
                        android:layout_width="42dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="1"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_quantity_plus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_orange"
                        android:gravity="center"
                        android:text="+"
                        android:textAppearance="@style/TextAppearance.SoleStep.Body"
                        android:textColor="@color/brand_white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_stock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/detail_label_description"
                    android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/detail_description_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="Mẫu sneaker da cổ thấp kinh điển, dễ phối đồ và phù hợp đi hằng ngày."
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_label_reviews"
                        android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_reviews_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/detail_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_detail_bottom_bar"
        android:elevation="@dimen/elev_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingEnd="@dimen/space_screen_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_to_cart_button"
            style="@style/Widget.SoleStep.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Thêm vào giỏ - 2.929.000 đ"
            app:icon="@drawable/ic_material_shopping_cart"
            app:iconTint="@color/brand_white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
