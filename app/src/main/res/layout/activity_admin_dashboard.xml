<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary"
    tools:context=".admin.AdminDashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/admin_bottom_nav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <View
                    android:id="@+id/profile_image_bg"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_circle_orange"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_shoe"
                    app:layout_constraintBottom_toBottomOf="@id/profile_image_bg"
                    app:layout_constraintEnd_toEndOf="@id/profile_image_bg"
                    app:layout_constraintStart_toStartOf="@id/profile_image_bg"
                    app:layout_constraintTop_toTopOf="@id/profile_image_bg"
                    app:tint="@color/brand_white" />

                <TextView
                    android:id="@+id/admin_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Bảng điều khiển Admin"
                    android:textColor="@color/text_dark_tertiary"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/profile_image_bg"
                    app:layout_constraintTop_toTopOf="@id/profile_image_bg" />

                <TextView
                    android:id="@+id/app_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="SoleStep"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/admin_label"
                    app:layout_constraintTop_toBottomOf="@id/admin_label" />

                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_circle_dark"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home_bell"
                        app:tint="@color/text_dark_primary" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_badge_orange"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/brand_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange_gradient"
                android:padding="28dp">

                <TextView
                    android:id="@+id/revenue_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_today_revenue"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/revenue_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="3.284.500 ₫"
                    android:textColor="@color/brand_white"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/revenue_title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/revenue_amount">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_home_trending"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="+18.2% so với hôm qua"
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ══════════════════════════════════════
                 STATISTICS GRID
                 ══════════════════════════════════════ -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- Stat: Revenue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/stat_icon_1"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_dark"
                            android:backgroundTint="@color/stat_revenue_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textColor="@color/stat_revenue"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/stat_icon_1"
                            app:layout_constraintEnd_toEndOf="@id/stat_icon_1"
                            app:layout_constraintStart_toStartOf="@id/stat_icon_1"
                            app:layout_constraintTop_toTopOf="@id/stat_icon_1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗ +12%"
                            android:textColor="@color/status_success"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="48.2M"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_revenue"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Stat: Orders -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/stat_icon_2"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_dark"
                            android:backgroundTint="@color/stat_orders_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_material_shopping_cart"
                            app:layout_constraintBottom_toBottomOf="@id/stat_icon_2"
                            app:layout_constraintEnd_toEndOf="@id/stat_icon_2"
                            app:layout_constraintStart_toStartOf="@id/stat_icon_2"
                            app:layout_constraintTop_toTopOf="@id/stat_icon_2"
                            app:tint="@color/stat_orders" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗ +8%"
                            android:textColor="@color/status_success"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="284"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_orders"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Stat: Products -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/stat_icon_4"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_dark"
                            android:backgroundTint="@color/stat_products_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_material_inventory_2"
                            app:layout_constraintBottom_toBottomOf="@id/stat_icon_4"
                            app:layout_constraintEnd_toEndOf="@id/stat_icon_4"
                            app:layout_constraintStart_toStartOf="@id/stat_icon_4"
                            app:layout_constraintTop_toTopOf="@id/stat_icon_4"
                            app:tint="@color/stat_products" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↘ -2%"
                            android:textColor="@color/status_error"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="156"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_products"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Stat: Categories -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/stat_icon_3"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_dark"
                            android:backgroundTint="@color/orange_tint_10"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_tag"
                            app:layout_constraintBottom_toBottomOf="@id/stat_icon_3"
                            app:layout_constraintEnd_toEndOf="@id/stat_icon_3"
                            app:layout_constraintStart_toStartOf="@id/stat_icon_3"
                            app:layout_constraintTop_toTopOf="@id/stat_icon_3"
                            app:tint="@color/brand_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ổn định"
                            android:textColor="@color/status_info"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="12"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_categories"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="13sp" />
                </LinearLayout>
            </GridLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_recent_orders"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btn_view_all_orders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="Xem tất cả ›"
                    android:textColor="@color/brand_orange"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <View
                        android:id="@+id/order_img_1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark"
                        android:backgroundTint="@color/orange_tint_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_material_shopping_cart"
                        app:layout_constraintBottom_toBottomOf="@id/order_img_1"
                        app:layout_constraintEnd_toEndOf="@id/order_img_1"
                        app:layout_constraintStart_toStartOf="@id/order_img_1"
                        app:layout_constraintTop_toTopOf="@id/order_img_1"
                        app:tint="@color/brand_orange" />

                    <TextView
                        android:id="@+id/order_id_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="SS-10495"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/order_img_1"
                        app:layout_constraintTop_toTopOf="@id/order_img_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex Johnson"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="@id/order_id_1"
                        app:layout_constraintTop_toBottomOf="@id/order_id_1" />

                    <TextView
                        android:id="@+id/order_p_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$419.98"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_status_processing_dark"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="@string/status_processing"
                        android:textColor="@color/status_warning"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/order_p_1" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="@color/border_dark_light" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <View
                        android:id="@+id/order_img_2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark"
                        android:backgroundTint="@color/orange_tint_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_material_shopping_cart"
                        app:layout_constraintBottom_toBottomOf="@id/order_img_2"
                        app:layout_constraintEnd_toEndOf="@id/order_img_2"
                        app:layout_constraintStart_toStartOf="@id/order_img_2"
                        app:layout_constraintTop_toTopOf="@id/order_img_2"
                        app:tint="@color/brand_orange" />

                    <TextView
                        android:id="@+id/order_id_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="SS-10494"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/order_img_2"
                        app:layout_constraintTop_toTopOf="@id/order_img_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maria Garcia"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="@id/order_id_2"
                        app:layout_constraintTop_toBottomOf="@id/order_id_2" />

                    <TextView
                        android:id="@+id/order_p_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$229.99"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_status_processing_dark"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="@string/status_processing"
                        android:textColor="@color/status_warning"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/order_p_2" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="@color/border_dark_light" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <View
                        android:id="@+id/order_img_3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark"
                        android:backgroundTint="@color/orange_tint_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_material_shopping_cart"
                        app:layout_constraintBottom_toBottomOf="@id/order_img_3"
                        app:layout_constraintEnd_toEndOf="@id/order_img_3"
                        app:layout_constraintStart_toStartOf="@id/order_img_3"
                        app:layout_constraintTop_toTopOf="@id/order_img_3"
                        app:tint="@color/brand_orange" />

                    <TextView
                        android:id="@+id/order_id_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="SS-10493"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/order_img_3"
                        app:layout_constraintTop_toTopOf="@id/order_img_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="James Lee"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="@id/order_id_3"
                        app:layout_constraintTop_toBottomOf="@id/order_id_3" />

                    <TextView
                        android:id="@+id/order_p_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$379.97"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_status_shipped_dark"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="@string/status_shipped"
                        android:textColor="@color/status_info"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/order_p_3" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="@color/border_dark_light" />

                <androidx.constraintlayout.widget.ConstraintLayout
