<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".user.ProductReviewActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_screen_vertical"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingBottom="@dimen/space_screen_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="@dimen/btn_icon_size"
            android:layout_height="@dimen/btn_icon_size"
            android:background="@drawable/bg_rounded_gray"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/review_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/review_title"
            android:textAppearance="@style/TextAppearance.SoleStep.Subheading" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/border_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <ScrollView
        android:id="@+id/review_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen_horizontal"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_screen_horizontal"
            android:paddingBottom="@dimen/space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_6">

                <FrameLayout
                    android:id="@+id/review_product_image_container"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_product_thumb">

                    <ImageView
                        android:id="@+id/review_product_image"
                        android:layout_width="@dimen/icon_2xl"
                        android:layout_height="@dimen/icon_2xl"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shoe"
                        android:tint="@color/brand_orange" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/review_product_brand_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NovaSole"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption" />

                    <TextView
                        android:id="@+id/review_product_name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Air Phantom Pro"
                        android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/review_product_meta_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="US 10 · White · Order #SS-10482"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review_overall"
                    android:textAppearance="@style/TextAppearance.SoleStep.Body"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/star_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/star_1"
                        android:layout_width="@dimen/star_size_large"
                        android:layout_height="@dimen/star_size_large"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_1"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_star" />

                    <ImageButton
                        android:id="@+id/star_2"
                        android:layout_width="@dimen/star_size_large"
                        android:layout_height="@dimen/star_size_large"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_2"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_star" />

                    <ImageButton
                        android:id="@+id/star_3"
                        android:layout_width="@dimen/star_size_large"
                        android:layout_height="@dimen/star_size_large"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_3"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_star" />

                    <ImageButton
                        android:id="@+id/star_4"
                        android:layout_width="@dimen/star_size_large"
                        android:layout_height="@dimen/star_size_large"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_4"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_star" />

                    <ImageButton
                        android:id="@+id/star_5"
                        android:layout_width="@dimen/star_size_large"
                        android:layout_height="@dimen/star_size_large"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_5"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_star" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rating_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/review_tags_title"
                android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                android:textColor="@color/text_secondary" />

            <GridLayout
                android:id="@+id/review_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:columnCount="2">

                <TextView
                    android:id="@+id/review_tag_comfortable"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:background="@drawable/bg_review_tag_selected"
                    android:gravity="center"
                    android:text="Thoải mái"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/brand_white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/review_tag_true_to_size"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:background="@drawable/bg_review_tag"
                    android:gravity="center"
                    android:text="Đúng kích cỡ"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/review_tag_quality"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:background="@drawable/bg_review_tag_selected"
                    android:gravity="center"
                    android:text="Chất lượng tuyệt vời"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/brand_white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/review_tag_fast_delivery"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:background="@drawable/bg_review_tag"
                    android:gravity="center"
                    android:text="Giao hàng nhanh"
                    android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                    android:textColor="@color/text_secondary" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="@string/review_your_review"
                android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/review_edit_text"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_input_light"
                android:gravity="top|start"
                android:hint="@string/review_text_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:padding="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.SoleStep.BodySmall"
                android:textColor="@color/text_secondary"
                android:textColorHint="@color/text_placeholder" />

            <TextView
                android:id="@+id/review_char_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="end"
                android:text="0/500"
                android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                android:textColor="@color/text_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/review_photos_title"
                android:textAppearance="@style/TextAppearance.SoleStep.Overline"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/review_photos_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/add_review_photo_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_photo_add"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/text_placeholder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thêm"
                        android:textAppearance="@style/TextAppearance.SoleStep.Caption"
                        android:textColor="@color/text_placeholder" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/review_photo_thumbnail"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_product_thumb">

                    <ImageView
                        android:layout_width="@dimen/icon_2xl"
                        android:layout_height="@dimen/icon_2xl"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shoe"
                        android:tint="@color/brand_orange" />
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit_review_button"
                style="@style/Widget.SoleStep.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/review_btn_submit" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
