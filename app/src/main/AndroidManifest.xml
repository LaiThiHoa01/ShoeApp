<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/shoe_logo_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/shoe_logo_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoleStep">
        <activity
            android:name=".user.PaymentNotification"
            android:exported="true" />
        <activity
            android:name=".admin.UserManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".user.ProductReviewActivity"
            android:exported="false" />
        <activity
            android:name=".user.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".user.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".user.CartActivity"
            android:exported="false" />
        <activity
            android:name=".user.CheckoutActivity"
            android:exported="true"
            android:label="Merchant Demo"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="app"
                    android:scheme="demozpdk" />
            </intent-filter>
        </activity>
        <activity
            android:name=".user.CatalogActivity"
            android:exported="false" />
        <activity
            android:name=".user.MyOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".user.OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".user.MainActivity"
            android:exported="false" />
        <activity
            android:name=".authentication.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".authentication.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".authentication.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin">

            <!-- <intent-filter> -->
            <!-- <action android:name="android.intent.action.MAIN" /> -->
            <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            <!-- </intent-filter> -->
        </activity>
        <activity
            android:name=".admin.AdminProductsActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".admin.AdminOrderManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".admin.AdminCategoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".admin.AdminAddProductActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".admin.AdminOrderDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
        <activity
            android:name=".admin.AdminProductVariantActivity"
            android:exported="false"
            android:theme="@style/Theme.SoleStep.Admin" />
    </application>

</manifest>